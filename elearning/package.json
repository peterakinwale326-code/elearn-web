{
  "name": "elearning",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "api:dev": "node --watch --env-file=.env.local server/index.mjs",
    "api:start": "node --env-file=.env.local server/index.mjs",
    "db:check": "node --env-file=.env.local scripts/check-db.cjs",
    "db:seed": "node --env-file=.env.local scripts/repair-assessments.mjs && node --env-file=.env.local scripts/seed-curriculum.mjs",
    "db:migrate-auth": "node --env-file=.env.local scripts/migrate-auth.mjs",
    "lint": "eslint"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "lucide-react": "^1.48.0",
    "mysql2": "^3.24.5",
    "next": "16.3.6",
    "nodemailer": "^10.0.13",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
